AAA,CACA,aAAA,CGzjCF,6EAAA,CACA,kCAAA,CACA,iCAAA,CACA,uCAAA,CACA,6BAAA,CACA,4BAAA,CACA,iBAAA,CACA,mBAAA,CACA,mBAAA,CACA,gCAAA,CACA,aAAA,CACA,iBAAA,CACA,mBAAA,CACA,6BAAA,CH+iCE,kBAAA,CACA,WAAA,CACA,UAAA,CAKJ,eACE,YAAA,CACA,6BAAA,CACA,aAAA,CAEA,iBACE,YAAA,CAGF,wBACE,qBAAA,CAIJ,mBACE,oBAAA,CACA,kBAAA,CAGF,uBACE,oBAAA,CACA,iBAAA,CAIF,MACE,oBAAA,CACA,4CAAA,CACA,aACE,iBAAA,CACA,QAAA,CACA,WAAA,CACA,kBAAA,CACA,UAAA,CAEF,eACE,YAAA,CAKJ,iBACE,cAAA,CAGF,YACE,YAAA,CAGF,GACE,cAAA,CAGF,aACE,eAAA,CACA,UAAA,CACA,gBAAA,CACA,gBAAA,CACA,iBAAA,CACA,iBAAA,CAKF,WACE,gBAAA,CACA,2BAAA,CACA,oBAAA,CAGA,cACE,iBAAA,CACA,sBAAA,CAEA,qBACE,mBAAA,CACA,oBAAA,CACA,kBAAA,CACA,UAAA,CACA,gBAAA,CACA,iBAAA,CACA,iBAAA,CAEA,iBAAA,CAEA,iBAAA,CAON,QACE,gBAAA,CAEF,OACE,gBAAA,CAEF,OACE,eAAA,CAEF,SACE,eAAA,CAEF,WACE,eAAA,CAGF,UACE,eAAA,CAGF,UACE,iBAAA,CAGF,eACE,gBAAA,CACA,kBAAA,CACA,qBACE,mBAAA,CAIJ,YACE,UAAA,CACA,sBAAA,CAMF,OACE,WAAA","sourcesContent":["@use \'~@fortawesome/fontawesome-free/scss/fontawesome\';\\n@use \'~@fortawesome/fontawesome-free/scss/fa\' as fa;\\n@use \'~@fortawesome/fontawesome-free/scss/mixins\' as fa-mixins;\\n@use \'~@fortawesome/fontawesome-free/scss/regular\';\\n@use \'~@fortawesome/fontawesome-free/scss/solid\';\\n@use \'~@fortawesome/fontawesome-free/scss/brands\';\\n\\n@use \'sass:color\';\\n\\n@use \'bootstrap-light\';\\n\\n@import url(\'~reveal.js/dist/theme/white.css\');\\n@import url(\'~reveal.js/dist/reveal.css\');\\n\\n// @import \'~reveal.js-plugins/menu/menu.css\';\\n\\n// katex\\n// @import \'~katex/dist/katex.css\';\\n\\n// font-awesome\\n// @import \'~@fortawesome/fontawesome-free/scss/fontawesome\';\\n// @import \'~@fortawesome/fontawesome-free/scss/regular\';\\n// @import \'~@fortawesome/fontawesome-free/scss/solid\';\\n// @import \'~@fortawesome/fontawesome-free/scss/brands\';\\n\\n\\n// @import \'svg\';\\n\\n.reset {\\n  all: revert;\\n}\\n\\n// Landscape printing\\n@media print{\\n  @page {\\n    size: a4;\\n    orientation: landscape;\\n  }\\n  #toggle-chalkboard, #toggle-notes {\\n    display: none;\\n  }\\n}\\n\\n$caption-color: #000;\\n$link-color: #2a76dd;\\n$maincolor: #710600;\\n\\n// --- Blocks\\n\\n%block {\\n  break-inside: avoid;\\n  position: relative;\\n  border-radius: 10px;\\n\\n  margin-top: 1rem;\\n  padding: 0;\\n\\n  // .small & {\\n  //   padding: .2rem 8px;\\n  // }\\n\\n  & > title::before {\\n    @include fa-mixins.fa-icon;\\n  }\\n  & > .title {\\n    position: relative;\\n    max-width: max-content;\\n    min-height: 1rem;\\n\\n\\n    margin: 0px auto 0 5px;\\n    padding: 0 5px;\\n\\n    top: -.7rem;\\n    .small & {\\n      top: -.35rem;\\n    }\\n\\n    & > span {\\n      font-weight: bold;\\n      background: white;\\n    }\\n  }\\n\\n  & > .content {\\n    position: relative;\\n    padding: 5px 10px 0 10px;\\n    top: -.7rem;\\n    margin-bottom: -.5rem;\\n\\n    grid-column: 1 / 3;\\n    grid-row: 2/3;\\n  }\\n\\n\\n}\\n\\n\\ninput {\\n  background: #DBEDF3;\\n  border: 1px solid #eee;\\n}\\n\\ninput[type=\'submit\']:hover {\\n  background: red;\\n}\\n\\n@mixin block($fa-var-icon: null, $source: null, $color: #2933aa, $icon-color: null, $right: false) {\\n  @extend %block;\\n\\n  $bgcolor: color.adjust($color,  $lightness: -50%);\\n\\n  // box-shadow: 1px 1px 1px $bgcolor;\\n\\n  border: 2px solid $color;\\n\\n  & > .title {\\n    color: $color;\\n  }\\n\\n  @if ($fa-var-icon) {\\n    @if ($right) {\\n      & > .title > span::after {\\n        @extend #{$source};\\n        color: $icon-color;\\n        padding-left: .2em;\\n        content: fa.fa-content($fa-var-icon);\\n      }\\n    } @else {\\n      & > .title > span::before {\\n        @extend #{$source};\\n        color: $icon-color;\\n        padding-right: .2em;\\n        content: fa.fa-content($fa-var-icon);\\n      }\\n\\n    }\\n  }\\n}\\n\\n.block.fill-height > .content {\\n  height: 100%;\\n}\\n\\n// --- Quick symbols\\n\\n\\ni.then {\\n    @extend .fa;\\n    @extend .fa-arrow-circle-right;\\n    color: #800;\\n}\\n\\n\\n\\n// --- Main document\\n\\n.pdf-mode .html-only { display: none }\\n.html-mode .pdf-only { display: none }\\n\\n.slides {\\n  height: 100%;\\n  top: 0;\\n  margin-top: 0;\\n\\n  & > section {\\n    min-height: 90%;\\n  }\\n}\\n\\n#parameter-form {\\n  display: none;\\n}\\n\\n\\n.reveal dl {\\n  margin: 0;\\n  padding: 0em;\\n}\\n.reveal dl dt {\\n    font-weight: bold;\\n    margin: 0;\\n    padding: 1em 0 0 0;\\n    color: color.adjust(blue,  $lightness: -25%);\\n}\\n.reveal dl dd {\\n  margin-left: 0;\\n}\\n\\n@page {\\n  margin: 0;\\n  padding: 0;\\n}\\n\\n\\n#header {\\n  text-align: center;\\n  background: #710600;\\n  color: white;\\n  font-size: .6rem;\\n  font-variant: small-caps;\\n  padding: 0;\\n  margin: 0;\\n  border-bottom: 1px solid black;\\n  top: 0;\\n  left: 0;\\n  display: flex;\\n  width: 100%;\\n  flex-direction: row;\\n  flex-wrap: nowrap;\\n  justify-content: space-between;\\n\\n  a {\\n    color: #ffffff;\\n    text-decoration: none;\\n    &:hover {\\n      text-decoration: underline;\\n    }\\n  }\\n\\n  #header-title {\\n    font-weight: bold;\\n  }\\n\\n}\\n\\n.break-after {\\n  break-after: always;\\n  page-break-after: always;\\n}\\n\\n.avoid-break {\\n  break-inside: avoid;\\n  page-break-inside: avoid;\\n}\\n\\n.float-left {\\n  float: left;\\n}\\n.float-right {\\n  float: right;\\n}\\n\\n// Grid helpers\\n\\n.grid {\\n  display: grid;\\n  & > * {\\n    margin: 10px;\\n  }\\n  &.compact > * {\\n    margin: 3px;\\n  }\\n}\\n\\n// Spread boxes horizontally\\n.spread, .columns {\\n  display: flex;\\n  align-items: stretch;\\n  justify-content: space-around;\\n  flex-direction: row;\\n\\n  & > * {\\n    margin: 10px !important;\\n    flex-grow: 1;\\n    flex-basis: 0;\\n  }\\n}\\n\\n\\n\\n\\n// ---\\n// --- Reveal section\\n// ---\\n\\n\\n.reveal section {\\n  position: relative;\\n  text-align: left;\\n  font-size: 1rem;\\n\\n\\n  a.edit-link:before {\\n    @include fa-mixins.fa-icon;\\n    @extend .far;\\n    content: fa.fa-content(fa.$var-edit);\\n    cursor: pointer;\\n  }\\n  a.edit-link {\\n    color: lightblue;\\n    position: fixed;\\n    top: 0px;\\n    right: 0;\\n    z-index: 999999;\\n    visibility: visible;\\n  }\\n  a.edit-link {\\n    opacity: 0%;\\n  }\\n\\n  a.edit-link:hover {\\n    opacity: 100%;\\n  }\\n\\n  &.center, &.header {\\n    h1 {\\n      color: white;\\n      background: #800;\\n      box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.25);\\n      color: white;\\n    }\\n  }\\n\\n  .fragment.exclusive {\\n    display: hidden !important;\\n    width: 0;\\n    height: 0;\\n    overflow: hidden;\\n    &.visible {\\n      display: hidden;\\n    }\\n\\n    &.current-fragment {\\n      display: inherit;\\n      width: inherit;\\n      height: inherit;\\n    }\\n  }\\n\\n  // Display only when current-fragment is on\\n  .fragment.only {\\n    display: none;\\n\\n    &.current-fragment {\\n      display: inherit;\\n    }\\n  }\\n\\n\\n\\n\\n  ol, ul, dl {\\n    display: block;\\n    // margin: 0;\\n  }\\n\\n  ul > li {\\n    &::marker { color: blue; }\\n    ul > li {\\n      &::marker { color: lightblue; }\\n    }\\n  }\\n\\n\\n  .center {\\n    text-align: center;\\n  }\\n\\n  .grid > h1, h2, h3 {\\n    margin: 0;\\n  }\\n\\n  h1, h2, h3 {\\n    color: darkblue;\\n    margin-top: 20px;\\n    margin-bottom: 5px;\\n    text-transform: none;\\n    font-variant: small-caps;\\n\\n    &:first-child {\\n      margin-top: 0px;\\n    }\\n    &.space {\\n      margin-top: 20px;\\n    }\\n  }\\n  h1 {\\n    font-size: 1.3rem;\\n  }\\n  h2 {\\n    font-weight: bolder;\\n    font-size: 1.1rem;\\n  }\\n  h3 {\\n    font-size: 1rem;\\n    font-weight: 100;\\n  }\\n\\n\\n\\n  img {\\n    border: 0;\\n    margin: 0.3rem;\\n  }\\n\\n  sup, sub {\\n    font-size: 75%;\\n  }\\n\\n  .nospace {\\n    margin-top: 0em;\\n  }\\n  .space {\\n    margin-top: 1em;\\n  }\\n  .space2x {\\n    margin-top: 2em;\\n  }\\n\\n\\n  .smallcaps {\\n    font-variant: small-caps;\\n  }\\n\\n  .inline-blocks > * {\\n    display: inline-block;\\n  }\\n  .inline-block, div.inline {\\n    display: inline-block;\\n  }\\n  div.flex {\\n    display: flex;\\n  }\\n\\n  .flex-space-between {\\n    display: flex;\\n    justify-content: space-between\\n  }\\n  .flex-space-around {\\n    display: flex;\\n    justify-content: space-around\\n  }\\n\\n  .ta-left {\\n    text-align: left;\\n  }\\n\\n  .va-top {\\n    vertical-align: top;\\n  }\\n  .va-middle {\\n    vertical-align: middle;\\n  }\\n  .va-bottom {\\n    vertical-align: bottom;\\n  }\\n\\n\\n  figure {\\n    margin: auto;\\n    text-align: center;\\n    border: 1px dotted rgba(0, 0, 0, 0.15);\\n    // box-shadow: 0 0 10px rgba(0, 0, 0, 0.15);\\n\\n    img {\\n      box-shadow: none;\\n    }\\n    figcaption {\\n      font-size: .75rem;\\n      color: $caption-color;\\n    }\\n  }\\n\\n  .twocolumns, .two-columns {\\n    columns: 2;\\n  }\\n\\n  & > video {\\n    margin: auto;\\n  }\\n\\n  .fa-ul {\\n    list-style-type: none;\\n  }\\n\\n  span.hand::before {\\n    @include fa-mixins.fa-icon;\\n    @extend .far;\\n    content: fa.fa-content(fa.$var-hand-point-right);\\n    padding-right: 0.5rem;\\n  }\\n\\n  .right-arrow::before {\\n    @include fa-mixins.fa-icon;\\n    @extend .fas;\\n    content: fa.fa-content(fa.$var-arrow-circle-right);\\n    padding-right: 0.5rem;\\n    color: #555;\\n  }\\n\\n  ul.hand {\\n    list-style: none;\\n    & > li:before {\\n      @include fa-mixins.fa-icon;\\n      @extend .far;\\n      content: fa.fa-content(fa.$var-hand-point-right);\\n      padding-right: 0.5rem;\\n    }\\n  }\\n\\n  div.hand::before {\\n    @include fa-mixins.fa-icon;\\n    @extend .far;\\n    content: fa.fa-content(fa.$var-hand-point-right);\\n    padding-right: 0.5rem;\\n  }\\n\\n  div.experiment::before {\\n    @include fa-mixins.fa-icon;\\n    @extend .fas;\\n    content: fa.fa-content(fa.$var-vial);\\n    color: blue;\\n    padding-right: 0.5rem;\\n  }\\n\\n  div.warning::before {\\n    @include fa-mixins.fa-icon;\\n    @extend .fas;\\n    content: fa.fa-content(fa.$var-exclamation-triangle);\\n    color: orange;\\n    padding-right: 0.5rem;\\n  }\\n\\n  div.comments::before {\\n    @include fa-mixins.fa-icon;\\n    @extend .fas;\\n    content: fa.fa-content(fa.$var-comments);\\n    color: blue;\\n    padding-right: 0.5rem;\\n  }\\n\\n  div.documentation::before {\\n    @include fa-mixins.fa-icon;\\n    @extend .fas;\\n    content: fa.fa-content(fa.$var-book);\\n    color: blue;\\n    padding-right: 0.5rem;\\n  }\\n\\n\\n  .eg {\\n    color: color.adjust(rgb(122, 135, 209), $lightness: -20%)\\n  }\\n  .eg::before {\\n    @include fa-mixins.fa-icon;\\n    @extend .fa;\\n    color: rgb(122, 135, 209);\\n    content: fa.fa-content(fa.$var-comment);\\n    padding-right: 0.5rem;\\n  }\\n\\n  .boxed {\\n    border: 1px solid black;\\n    padding: 3px;\\n  }\\n\\n  .comment {\\n    color: #777;\\n  }\\n\\n  .details {\\n    font-size: 90%;\\n    color: $caption-color;\\n  }\\n\\n  a img {\\n    box-shadow: unset;\\n  }\\n  /* Link with URL */\\n  a.url {\\n    font-size: 75%;\\n  }\\n\\n  a.external, a.external:hover, a.external:visited {\\n    color: inherit;\\n    text-decoration: none;\\n    &:hover {\\n      color: #2a76dd;\\n    }\\n    &::before {\\n      @include fa-mixins.fa-icon;\\n      font-size: 75%;\\n      color: $link-color;\\n      padding-right: 0.2em;\\n      @extend .fas;\\n      vertical-align: 10%;\\n      content: fa.fa-content(fa.$var-external-link-alt);\\n    }\\n\\n  }\\n\\n  a.wikipedia{\\n    border: 1px solid #dddddd;\\n    border-radius: 5px;\\n    padding: 0px;\\n\\n    &::before {\\n      @include fa-mixins.fa-icon;\\n      @extend .fab;\\n      color: black;\\n      content: fa.fa-content(fa.$var-wikipedia-w);\\n      padding-right: 5px;\\n    }\\n    &:hover {\\n      color: white;\\n      background: #2a76dd;\\n    }\\n  }\\n\\n  .positive-aspect::before {\\n    @include fa-mixins.fa-icon;\\n    @extend .far;\\n    color: green;\\n    margin-right: 0.2em;\\n    content: fa.fa-content(fa.$var-plus-square);\\n  }\\n  .negative-aspect::before {\\n    @include fa-mixins.fa-icon;\\n    @extend .far;\\n    color: red;\\n    margin-right: 0.2em;\\n    content: fa.fa-content(fa.$var-minus-square);\\n  }\\n\\n  .bold {\\n    font-weight: bold;\\n  }\\n\\n  .centered {\\n    display: block;\\n    margin-left: auto;\\n    margin-right: auto;\\n  }\\n  .inline.centered {\\n    display: inline-block;\\n  }\\n  .inline.center > * {\\n    text-align: left;\\n  }\\n\\n  .d-absolute {\\n    position: absolute;\\n  }\\n\\n  .d-relative {\\n    position: relative;\\n  }\\n\\n  .v-center {\\n    position: absolute;\\n    top: 50%;\\n    transform: translateY(-50%);\\n  }\\n\\n  .h-center {\\n    position: absolute;\\n    left: 50%;\\n    transform: translateX(-50%);\\n  }\\n\\n  .hv-center {\\n    position: absolute;\\n    top: 50%;\\n    left: 50%;\\n    transform: translate(-50%, -50%);\\n  }\\n\\n\\n  // Like a paragraph\\n  div.p {\\n    margin-top: 1em;\\n  }\\n\\n  .parse-error {\\n    color: red;\\n    &::before {\\n      @include fa-mixins.fa-icon;\\n      content: fa.fa-content(fa.$var-bath);\\n      margin-right: 0.3em;\\n    }\\n  }\\n\\n  // Slide author\\n  .author {\\n    font-weight: bold;\\n    font-size: 1.2rem;\\n  }\\n\\n  .bold {\\n    font-weight: bolder;\\n  }\\n\\n\\n\\n  //\\n  // --- Special parts (definition, etc.)\\n  //\\n\\n  $block-darkblue: rgb(53, 53, 216);\\n  $block-orange: rgb(248, 159, 26);\\n  $block-color-alert: #600;\\n\\n  // Information & definitions\\n  .block {\\n    @include block();\\n  }\\n\\n  .codeframe {\\n    @include block(fa.$var-code, \\".fas\\");\\n    & > .content {\\n      padding: 0;\\n      margin-left: 0;\\n      margin-right: 0;\\n\\n      & > .hljs-code pre {\\n        width: 95%;\\n        // margin: 0;\\n        // padding: 0;\\n      }\\n\\n      & > .hljs-code code.hljs {\\n        margin: 0;\\n        padding: 6pt;\\n        border: 0;\\n        border-radius: 3pt;\\n      }\\n\\n    }\\n  }\\n\\n  .definition {\\n    @include block(fa.$var-location-arrow, \\".fas\\");\\n  }\\n  .observation {\\n    @include block(fa.$var-microscope, \\".fas\\", $right: true);\\n  }\\n  // .task {\\n  //   @include block(#ccf, fa.$var-tasks, \\".fas\\");\\n  // }\\n  // .soa {\\n  //   @include block(lighten(#beb, 10%), fa.$var-newspaper, \\".fas\\");\\n  // }\\n\\n  .alert {\\n    @include block(fa.$var-exclamation-circle, \\".fas\\");\\n  }\\n\\n  .limitations {\\n    @include block(fa.$var-thumbs-down, \\".fas\\", $icon-color: #a00);\\n  }\\n\\n  .interest {\\n    @include block(fa.$var-thumbs-up, \\".fas\\", $icon-color: #800);\\n  }\\n\\n  .idea {\\n    @include block(fa.$var-lightbulb, \\".fas\\", $icon-color: #00aeff);\\n  }\\n\\n  .remark {\\n    @include block(fa.$var-comment, \\".fas\\");\\n  }\\n\\n  .soa {\\n    @include block(fa.$var-paperclip, \\".fas\\");\\n  }\\n\\n  // .block-summary {\\n  //   @include block(#bbe, fa.$var-cloud-sun-rain, \\".fas\\")\\n  // }\\n\\n  .goal {\\n    @include block(fa.$var-bullseye, \\".fas\\");\\n  }\\n\\n  .motivation {\\n    @include block(fa.$var-sun, \\".far\\");\\n  }\\n\\n  .code {\\n    $codecolor: rgba(63.2%, 87%, 63.2%, 80%);\\n\\n    @include block(fa.$var-code, \\".fas\\");\\n    pre code.hljs {\\n      font-size: 0.8rem;\\n      line-height: .9rem;;\\n    }\\n    pre {\\n      box-shadow: none;\\n      border: 0;\\n      margin: 5px;\\n    }\\n    code.hljs {\\n      border: 0;\\n      background: inherit;\\n    }\\n\\n    .fa-running {\\n      color: color.adjust($codecolor, $lightness: -50%);\\n      cursor: pointer;\\n      margin-right: 10px;\\n    }\\n    .fa-running:hover {\\n      color: $codecolor;\\n    }\\n  }\\n\\n\\n  .theorem {\\n    @include block(fa.$var-grav, \\".fab\\");\\n  }\\n\\n  // .exercice {\\n  //   @include block(rgb(150, 0, 0), fa.$var-running, \\".fas\\");\\n  // }\\n\\n  .question {\\n    @include block(fa.$var-question-circle, \\".fas\\", $right: true);\\n  }\\n  .solution {\\n    @include block(fa.$var-tower-cell, \\".fas\\", $right: false);\\n  }\\n  .problem {\\n    // @include block(fa.$var-question-circle, \\".fas\\");\\n    @include block(fa.$var-exclamation-triangle, \\".fas\\", $right: false);\\n  }\\n  // .observation {\\n  //   @include block(rgb(12, 104, 190),  fa.$var-glasses, \\".fas\\");\\n  // }\\n  // .hypothesis {\\n  //   @include block(rgb(12, 104, 190),  fa.$var-flask, \\".fas\\");\\n  // }\\n\\n  .algorithm {\\n    @include block(fa.$var-check-square, \\".fas\\");\\n\\n    .block {\\n      border-left: 1px solid gray;\\n      margin-left: 1em;\\n      padding-left: 0.5em;\\n    }\\n  }\\n\\n  .example {\\n    @include block(fa.$var-flask-vial, \\".fas\\");\\n    // border: 1px solid #afa;\\n  }\\n\\n  .case-study {\\n    @include block(fa.$var-book-open, \\".fas\\");\\n    // border: 1px solid #afa;\\n  }\\n\\n\\n\\n  // ---\\n  // --- Special objects\\n  // ---\\n\\n\\n  // Player\\n  .player-container {\\n    .actions {\\n      display: block;\\n    }\\n    .action {\\n      padding-right: .5em;\\n    }\\n    .action-playpause::before {\\n      @include fa-mixins.fa-icon;\\n      @extend .fas;\\n      content: fa.fa-content(fa.$var-play);\\n    }\\n    .action-playpause.playing::before {\\n      content: fa.fa-content(fa.$var-pause);\\n    }\\n  }\\n\\n  .parameter {\\n    color: blue;\\n    background: #eee;\\n\\n    &::before {\\n      color: blue;\\n      @include fa-mixins.fa-icon;\\n      font-size: 0.7em;\\n      padding-right: 0.3rem;\\n      content: fa.fa-content(fa.$var-edit);\\n    }\\n  }\\n\\n  .action {\\n    color: blue;\\n    cursor: pointer;\\n\\n    &.toggle::before {\\n      color: blue;\\n      @include fa-mixins.fa-icon;\\n      font-size: 0.7em;\\n      padding-right: 0.3rem;\\n      content: fa.fa-content(fa.$var-square);\\n    }\\n    &.toggle.selected::before {\\n      color: blue;\\n      @include fa-mixins.fa-icon;\\n      font-size: 0.7em;\\n      padding-right: 0.3rem;\\n      content: fa.fa-content(fa.$var-check-square);\\n    }\\n    &.radio::before {\\n      color: blue;\\n      @include fa-mixins.fa-icon;\\n      font-size: 0.7em;\\n      padding-right: 0.3rem;\\n      content: fa.fa-content(fa.$var-circle);\\n    }\\n    &.radio.selected::before {\\n      color: blue;\\n      @include fa-mixins.fa-icon;\\n      font-size: 0.7em;\\n      padding-right: 0.3rem;\\n      content: fa.fa-content(fa.$var-check-circle);\\n    }\\n  }\\n\\n  // Quote\\n  div.quote {\\n    font-style: italic;\\n    color: #444;\\n    .source {\\n      text-align: right;\\n      margin-right: 3em;\\n    }\\n    &::before {\\n      float: left;\\n      @include fa-mixins.fa-icon;\\n      @extend .fas;\\n      font-size: 0.8em;\\n      content: fa.fa-content(fa.$var-quote-left);\\n      padding-right: 1rem;\\n      color: #ccc;\\n    }\\n    &::after {\\n      float: right;\\n      @include fa-mixins.fa-icon;\\n      @extend .fas;\\n      font-size: 0.8em;\\n      content: fa.fa-content(fa.$var-quote-right);\\n      padding-right: 1rem;\\n      color: #ccc;\\n    }\\n  }\\n\\n  // A paper citation\\n  .paper.normal {\\n    font-size: 1rem;\\n    color: #444;\\n  }\\n\\n  .csl-entry {\\n    color: #004;\\n    font-style: italic;\\n    font-size: .6rem;\\n    a::before {\\n      @extend .far;\\n      @include fa-mixins.fa-icon;\\n      padding-right: 0.2em;\\n      content: fa.fa-content(fa.$var-newspaper);\\n    }\\n    a {\\n      color: #004;\\n    }\\n  }\\n\\n  span.csl-inline div {\\n    display: inline;\\n  }\\n\\n  .paper {\\n    @extend .csl-entry;\\n\\n    a::before {\\n      @include fa-mixins.fa-icon;\\n      @extend .fas;\\n      content: fa.fa-content(fa.$var-external-link-alt);\\n      color: #a00;\\n      padding-right: 0.2em;\\n    }\\n  }\\n\\n\\n\\n  .csl-left-margin, .csl-right-inline {\\n    display: inline;\\n  }\\n\\n  table.center {\\n    td, th {\\n      text-align: center;\\n    }\\n  }\\n\\n  table {\\n    td {\\n      border: 2px solid grey;\\n    }\\n    th {\\n      border: none;\\n    }\\n    thead {\\n      background: #fee;\\n    }\\n    thead, tbody {\\n      border: 1px solid black;\\n    }\\n  }\\n\\n} // .reveal\\n\\n.fillheight, .vfill {\\n  height: 100%;\\n}\\n\\n.vfill-content content {\\n  height: 100%;\\n}\\n\\n.error {\\n  color: red;\\n}\\n\\n.render::after {\\n  content: \\"Loading...\\";\\n  text-align: center;\\n}\\n.render.error::after {\\n  content: \\"Error when loading/running renderer\\";\\n  color: red;\\n  text-align: center;\\n}\\n.render.loaded::after {\\n  display: none;\\n}\\n\\n.red {\\n  color: red;\\n}\\n.orange {\\n  color: orange;\\n}\\n.green {\\n  color: green;\\n}\\n.yellow {\\n  color: yellow;\\n}\\n.dark-orange {\\n  color: color.adjust(orange, $lightness: 10%);\\n}\\n.gray {\\n  color: gray;\\n}\\n.blue {\\n  color: blue;\\n}\\n.bg-gray {\\n  background: lightgray;\\n}\\n\\n.bg-yellow {\\n  background: yellow;\\n}\\n\\n.reveal   .centering {\\n  margin: auto;\\n}\\n\\ninput.inline-edit {\\n  background: inherit;\\n}\\n\\n.inline-edit {\\n  border-bottom: 1px solid grid;\\n  &::before {\\n    position: absolute;\\n    color: #ddf;\\n    font-size: 50%;\\n    @include fa-mixins.fa-icon;\\n    @extend .fas;\\n    vertical-align: 10%;\\n    content: fa.fa-content(fa.$var-edit);\\n    z-index: -1;\\n  }\\n}\\n\\n// Grids\\n.reveal .grid2 {\\n  display: grid;\\n  grid-template-columns: 1fr 1fr;\\n  grid-gap: 10px;\\n\\n  & > * {\\n    padding: 10px;\\n  }\\n\\n  &.border > * {\\n    border: 1px solid black;\\n  }\\n}\\n\\n.center-grid-items {\\n  justify-items: center;\\n  align-items: center;\\n}\\n\\n.center-top-grid-items {\\n  justify-items: center;\\n  align-items: start;\\n}\\n\\n\\n.card {\\n  padding: 0 !important;\\n  box-shadow: 3px 3px 3px 3px rgba(30,30,30, .2);\\n  .title {\\n    text-align: center;\\n    margin: 0;\\n    padding: 5px;\\n    background: color.adjust($maincolor, $saturation: 30%);\\n    color: white;\\n  }\\n  .content {\\n    padding: 10px;\\n  }\\n}\\n\\n\\n.clickable:hover {\\n  cursor: pointer;\\n}\\n\\n.tex-macros {\\n  display: none;\\n}\\n\\nli {\\n  margin-top: 3px;\\n}\\n\\nspan.circled {\\n  background: blue;\\n  color: white;\\n  padding: 3px 12px;\\n  margin-right: 5px;\\n  border-radius: 50%;\\n  text-align: center;\\n}\\n\\n\\n// Circled numbers\\nol.circled {\\n  counter-reset: li;\\n  margin-left: 20px !important;\\n  list-style-type: none;\\n  // border: 1px solid black;\\n\\n  & > li {\\n    position: relative;\\n    padding: 10px 5px 5px 0;\\n\\n    &:before {\\n      content: counter(li);\\n      counter-increment: li;\\n      background: darkblue;\\n      color: white;\\n      padding: 3px 12px;\\n      margin-left: -40px;\\n      margin-right: 10px;\\n\\n      border-radius: 50%;\\n\\n      text-align: center;\\n    }\\n  }\\n}\\n\\n\\n// font size\\n.larger {\\n  font-size: 1.5rem;\\n}\\n.large {\\n  font-size: 1.2rem;\\n}\\n.small {\\n  font-size: 0.8rem;\\n}\\n.smaller {\\n  font-size: 0.6rem;\\n}\\n.x-smaller {\\n  font-size: 0.5rem;\\n}\\n\\n.smallest {\\n  font-size: 0.4rem;\\n}\\n// Figure\\n.relative {\\n  position: relative;\\n}\\n\\n.fig-highlight {\\n  border-width: 3px;\\n  border-style: solid;\\n  &:hover {\\n    border-style: double;\\n  }\\n}\\n\\n.phdstudent {\\n  color: blue;\\n  text-decoration: dotted;\\n}\\n\\n\\n// --- TODO: consider inclusion from bootstrap directly?\\n\\n.grow2 {\\n  flex-grow: 2\\n}\\n","/*!\\n * Font Awesome Free 7.0.1 by @fontawesome - https://fontawesome.com\\n * License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License)\\n * Copyright 2025 Fonticons, Inc.\\n */\\n// Font Awesome core compile (Web Fonts-based)\\n// -------------------------\\n\\n@use \'core\';\\n@use \'sizing\';\\n@use \'widths\';\\n@use \'list\';\\n@use \'bordered\';\\n@use \'pulled\';\\n@use \'animated\';\\n@use \'rotated-flipped\';\\n@use \'stacked\';\\n@use \'icons\';\\n","// base icon class definition\\n// -------------------------\\n@use \'variables\' as v;\\n@use \'mixins\' as m;\\n\\n.#{v.$css-prefix}-solid,\\n.#{v.$css-prefix}-regular,\\n.#{v.$css-prefix}-brands,\\n.#{v.$css-prefix}-classic,\\n.fas,\\n.far,\\n.fab,\\n.#{v.$css-prefix} {\\n  @include m.fa-icon();\\n}\\n\\n:is(\\n  .fas,\\n  .far,\\n  .fab,\\n  .#{v.$css-prefix}-solid,\\n  .#{v.$css-prefix}-regular,\\n  .#{v.$css-prefix}-brands,\\n  .#{v.$css-prefix}-classic,\\n  .fa\\n)::before {\\n  content: var(#{v.$icon-property})/\\"\\";\\n}\\n\\n@supports not (content: \'\'/\'\') {\\n:is(\\n  .fas,\\n  .far,\\n  .fab,\\n  .#{v.$css-prefix}-solid,\\n  .#{v.$css-prefix}-regular,\\n  .#{v.$css-prefix}-brands,\\n  .#{v.$css-prefix}-classic,\\n  .fa\\n)::before {\\n    content: var(#{v.$icon-property});\\n  }\\n}","// mixins\\n// --------------------------\\n@use \'variables\' as v;\\n\\n// base rendering for an icon\\n@mixin fa-icon($family: v.$family) {\\n  --_#{v.$css-prefix}-family: var(--#{v.$css-prefix}-family, var(--#{v.$css-prefix}-style-family, \'#{$family}\'));\\n  -webkit-font-smoothing: antialiased;\\n  -moz-osx-font-smoothing: grayscale;\\n  display: var(--#{v.$css-prefix}-display, #{v.$display});\\n  font-family: var(--_#{v.$css-prefix}-family);\\n  font-feature-settings: normal;\\n  font-style: normal;\\n  font-synthesis: none;\\n  font-variant: normal;\\n  font-weight: var(--#{v.$css-prefix}-style, #{v.$style});\\n  line-height: 1;\\n  text-align: center;\\n  text-rendering: auto;\\n  width: var(--#{v.$css-prefix}-width, #{v.$fw-width});\\n}\\n\\n// sets relative font-sizing and alignment (in _sizing)\\n@mixin fa-size ($font-size) {\\n  font-size: calc(#{$font-size} / #{v.$size-scale-base} * 1em); /* converts a #{$font-size}px size into an em-based value that\'s relative to the scale\'s #{v.$size-scale-base}px base */\\n  line-height: calc(1 / #{$font-size} * 1em); /* sets the line-height of the icon back to that of it\'s parent */\\n  vertical-align: calc(((6 / #{$font-size}) - (3 / 8)) * 1em); /* vertically centers the icon taking into account the surrounding text\'s descender */\\n}\\n","// sizing icons\\n// -------------------------\\n@use \'variables\' as v;\\n@use \'mixins\' as m;\\n\\n// literal magnification scale\\n@for $i from 1 through 10 {\\n  .#{v.$css-prefix}-#{$i}x {\\n    font-size: $i * 1em;\\n  }\\n}\\n\\n// step-based scale (with alignment)\\n@each $size, $value in v.$sizes {\\n  .#{v.$css-prefix}-#{$size} {\\n     @include m.fa-size($value);\\n  }\\n}\\n","// icon widths\\n// -------------------------\\n@use \'variables\' as v;\\n\\n.#{v.$css-prefix}-width-auto {\\n  --#{v.$css-prefix}-width: auto;\\n}\\n\\n.#{v.$css-prefix}-fw,\\n.#{v.$css-prefix}-width-fixed {\\n  --#{v.$css-prefix}-width: #{v.$fw-width};\\n}\\n","// icons in a list\\n// -------------------------\\n@use \'variables\' as v;\\n\\n.#{v.$css-prefix}-ul {\\n  list-style-type: none;\\n  margin-inline-start: var(--#{v.$css-prefix}-li-margin, #{v.$li-margin});\\n  padding-inline-start: 0;\\n\\n  > li { position: relative; }\\n}\\n\\n.#{v.$css-prefix}-li {\\n  inset-inline-start: calc(-1 * var(--#{v.$css-prefix}-li-width, #{v.$li-width}));\\n  position: absolute;\\n  text-align: center;\\n  width: var(--#{v.$css-prefix}-li-width, #{v.$li-width});\\n  line-height: inherit;\\n}\\n","//  bordered icons\\n// -------------------------\\n@use \'variables\' as v;\\n\\n/* Heads Up: Bordered Icons will not be supported in the future!\\n  - This feature will be deprecated in the next major release of Font Awesome (v8)!\\n  - You may continue to use it in this version *v7), but it will not be supported in Font Awesome v8.\\n*/\\n\\n/* Notes:\\n* --@{v.$css-prefix}-border-width = 1/16 by default (to render as ~1px based on a 16px default font-size)\\n* --@{v.$css-prefix}-border-padding =\\n  ** 3/16 for vertical padding (to give ~2px of vertical whitespace around an icon considering it\'s vertical alignment)\\n  ** 4/16 for horizontal padding (to give ~4px of horizontal whitespace around an icon)\\n*/\\n\\n.#{v.$css-prefix}-border {\\n  border-color: var(--#{v.$css-prefix}-border-color, #{v.$border-color});\\n  border-radius: var(--#{v.$css-prefix}-border-radius, #{v.$border-radius});\\n  border-style: var(--#{v.$css-prefix}-border-style, #{v.$border-style});\\n  border-width: var(--#{v.$css-prefix}-border-width, #{v.$border-width});\\n  box-sizing: var(--#{v.$css-prefix}-border-box-sizing, #{v.$border-box-sizing});\\n  padding: var(--#{v.$css-prefix}-border-padding, #{v.$border-padding});\\n}\\n","// pulled icons\\n// -------------------------\\n@use \'variables\' as v;\\n\\n.#{v.$css-prefix}-pull-left,\\n.#{v.$css-prefix}-pull-start {\\n  float: inline-start;\\n  margin-inline-end: var(--#{v.$css-prefix}-pull-margin, #{v.$pull-margin});\\n}\\n\\n.#{v.$css-prefix}-pull-right,\\n.#{v.$css-prefix}-pull-end {\\n  float: inline-end;\\n  margin-inline-start: var(--#{v.$css-prefix}-pull-margin, #{v.$pull-margin});\\n}\\n","// animating icons\\n// --------------------------\\n@use \'variables\' as v;\\n\\n.#{v.$css-prefix}-beat {\\n  animation-name: #{v.$css-prefix}-beat;\\n  animation-delay: var(--#{v.$css-prefix}-animation-delay, 0s);\\n  animation-direction: var(--#{v.$css-prefix}-animation-direction, normal);\\n  animation-duration: var(--#{v.$css-prefix}-animation-duration, 1s);\\n  animation-iteration-count: var(--#{v.$css-prefix}-animation-iteration-count, infinite);\\n  animation-timing-function: var(--#{v.$css-prefix}-animation-timing, ease-in-out);\\n}\\n\\n.#{v.$css-prefix}-bounce {\\n  animation-name: #{v.$css-prefix}-bounce;\\n  animation-delay: var(--#{v.$css-prefix}-animation-delay, 0s);\\n  animation-direction: var(--#{v.$css-prefix}-animation-direction, normal);\\n  animation-duration: var(--#{v.$css-prefix}-animation-duration, 1s);\\n  animation-iteration-count: var(--#{v.$css-prefix}-animation-iteration-count, infinite);\\n  animation-timing-function: var(--#{v.$css-prefix}-animation-timing, cubic-bezier(0.280, 0.840, 0.420, 1));\\n}\\n\\n.#{v.$css-prefix}-fade {\\n  animation-name: #{v.$css-prefix}-fade;\\n  animation-delay: var(--#{v.$css-prefix}-animation-delay, 0s);\\n  animation-direction: var(--#{v.$css-prefix}-animation-direction, normal);\\n  animation-duration: var(--#{v.$css-prefix}-animation-duration, 1s);\\n  animation-iteration-count: var(--#{v.$css-prefix}-animation-iteration-count, infinite);\\n  animation-timing-function: var(--#{v.$css-prefix}-animation-timing, cubic-bezier(.4,0,.6,1));\\n}\\n\\n.#{v.$css-prefix}-beat-fade {\\n  animation-name: #{v.$css-prefix}-beat-fade;\\n  animation-delay: var(--#{v.$css-prefix}-animation-delay, 0s);\\n  animation-direction: var(--#{v.$css-prefix}-animation-direction, normal);\\n  animation-duration: var(--#{v.$css-prefix}-animation-duration, 1s);\\n  animation-iteration-count: var(--#{v.$css-prefix}-animation-iteration-count, infinite);\\n  animation-timing-function: var(--#{v.$css-prefix}-animation-timing, cubic-bezier(.4,0,.6,1));\\n}\\n\\n.#{v.$css-prefix}-flip {\\n  animation-name: #{v.$css-prefix}-flip;\\n  animation-delay: var(--#{v.$css-prefix}-animation-delay, 0s);\\n  animation-direction: var(--#{v.$css-prefix}-animation-direction, normal);\\n  animation-duration: var(--#{v.$css-prefix}-animation-duration, 1s);\\n  animation-iteration-count: var(--#{v.$css-prefix}-animation-iteration-count, infinite);\\n  animation-timing-function: var(--#{v.$css-prefix}-animation-timing, ease-in-out);\\n}\\n\\n.#{v.$css-prefix}-shake {\\n  animation-name: #{v.$css-prefix}-shake;\\n  animation-delay: var(--#{v.$css-prefix}-animation-delay, 0s);\\n  animation-direction: var(--#{v.$css-prefix}-animation-direction, normal);\\n  animation-duration: var(--#{v.$css-prefix}-animation-duration, 1s);\\n  animation-iteration-count: var(--#{v.$css-prefix}-animation-iteration-count, infinite);\\n  animation-timing-function: var(--#{v.$css-prefix}-animation-timing, linear);\\n}\\n\\n.#{v.$css-prefix}-spin {\\n  animation-name: #{v.$css-prefix}-spin;\\n  animation-delay: var(--#{v.$css-prefix}-animation-delay, 0s);\\n  animation-direction: var(--#{v.$css-prefix}-animation-direction, normal);\\n  animation-duration: var(--#{v.$css-prefix}-animation-duration, 2s);\\n  animation-iteration-count: var(--#{v.$css-prefix}-animation-iteration-count, infinite);\\n  animation-timing-function: var(--#{v.$css-prefix}-animation-timing, linear);\\n}\\n\\n.#{v.$css-prefix}-spin-reverse {\\n  --#{v.$css-prefix}-animation-direction: reverse;\\n}\\n\\n.#{v.$css-prefix}-pulse,\\n.#{v.$css-prefix}-spin-pulse {\\n  animation-name: #{v.$css-prefix}-spin;\\n  animation-direction: var(--#{v.$css-prefix}-animation-direction, normal);\\n  animation-duration: var(--#{v.$css-prefix}-animation-duration, 1s);\\n  animation-iteration-count: var(--#{v.$css-prefix}-animation-iteration-count, infinite);\\n  animation-timing-function: var(--#{v.$css-prefix}-animation-timing, steps(8));\\n}\\n\\n// if agent or operating system prefers reduced motion, disable animations\\n// see: https://www.smashingmagazine.com/2020/09/design-reduced-motion-sensitivities/\\n// see: https://developer.mozilla.org/en-US/docs/Web/CSS/@media/prefers-reduced-motion\\n@media (prefers-reduced-motion: reduce) {\\n  .#{v.$css-prefix}-beat,\\n  .#{v.$css-prefix}-bounce,\\n  .#{v.$css-prefix}-fade,\\n  .#{v.$css-prefix}-beat-fade,\\n  .#{v.$css-prefix}-flip,\\n  .#{v.$css-prefix}-pulse,\\n  .#{v.$css-prefix}-shake,\\n  .#{v.$css-prefix}-spin,\\n  .#{v.$css-prefix}-spin-pulse {\\n    animation: none !important;\\n    transition: none !important;\\n  }\\n}\\n\\n@keyframes #{v.$css-prefix}-beat {\\n  0%, 90% { transform: scale(1); }\\n  45% { transform: scale(var(--#{v.$css-prefix}-beat-scale, 1.25)); }\\n}\\n\\n@keyframes #{v.$css-prefix}-bounce {\\n  0%   { transform: scale(1,1) translateY(0); }\\n  10%  { transform: scale(var(--#{v.$css-prefix}-bounce-start-scale-x, 1.1),var(--#{v.$css-prefix}-bounce-start-scale-y, 0.9)) translateY(0); }\\n  30%  { transform: scale(var(--#{v.$css-prefix}-bounce-jump-scale-x, 0.9),var(--#{v.$css-prefix}-bounce-jump-scale-y, 1.1)) translateY(var(--#{v.$css-prefix}-bounce-height, -0.5em)); }\\n  50%  { transform: scale(var(--#{v.$css-prefix}-bounce-land-scale-x, 1.05),var(--#{v.$css-prefix}-bounce-land-scale-y, 0.95)) translateY(0); }\\n  57%  { transform: scale(1,1) translateY(var(--#{v.$css-prefix}-bounce-rebound, -0.125em)); }\\n  64%  { transform: scale(1,1) translateY(0); }\\n  100% { transform: scale(1,1) translateY(0); }\\n}\\n\\n@keyframes #{v.$css-prefix}-fade {\\n  50% { opacity: var(--#{v.$css-prefix}-fade-opacity, 0.4); }\\n}\\n\\n@keyframes #{v.$css-prefix}-beat-fade {\\n  0%, 100% {\\n    opacity: var(--#{v.$css-prefix}-beat-fade-opacity, 0.4);\\n    transform: scale(1);\\n  }\\n  50% {\\n    opacity: 1;\\n    transform: scale(var(--#{v.$css-prefix}-beat-fade-scale, 1.125));\\n  }\\n}\\n\\n@keyframes #{v.$css-prefix}-flip {\\n  50% {\\n    transform: rotate3d(var(--#{v.$css-prefix}-flip-x, 0), var(--#{v.$css-prefix}-flip-y, 1), var(--#{v.$css-prefix}-flip-z, 0), var(--#{v.$css-prefix}-flip-angle, -180deg));\\n  }\\n}\\n\\n@keyframes #{v.$css-prefix}-shake {\\n  0% { transform: rotate(-15deg); }\\n  4% { transform: rotate(15deg); }\\n  8%, 24% { transform: rotate(-18deg); }\\n  12%, 28% { transform: rotate(18deg); }\\n  16% { transform: rotate(-22deg); }\\n  20% { transform: rotate(22deg); }\\n  32% { transform: rotate(-12deg); }\\n  36% { transform: rotate(12deg); }\\n  40%, 100% { transform: rotate(0deg); }\\n}\\n\\n@keyframes #{v.$css-prefix}-spin {\\n  0% { transform: rotate(0deg); }\\n  100% { transform: rotate(360deg); }\\n}\\n","// rotating + flipping icons\\n// -------------------------\\n@use \'variables\' as v;\\n\\n.#{v.$css-prefix}-rotate-90 {\\n  transform: rotate(90deg);\\n}\\n\\n.#{v.$css-prefix}-rotate-180 {\\n  transform: rotate(180deg);\\n}\\n\\n.#{v.$css-prefix}-rotate-270 {\\n  transform: rotate(270deg);\\n}\\n\\n.#{v.$css-prefix}-flip-horizontal {\\n  transform: scale(-1, 1);\\n}\\n\\n.#{v.$css-prefix}-flip-vertical {\\n  transform: scale(1, -1);\\n}\\n\\n.#{v.$css-prefix}-flip-both,\\n.#{v.$css-prefix}-flip-horizontal.#{v.$css-prefix}-flip-vertical {\\n  transform: scale(-1, -1);\\n}\\n\\n.#{v.$css-prefix}-rotate-by {\\n  transform: rotate(var(--#{v.$css-prefix}-rotate-angle, 0));\\n}\\n","// stacking icons\\n// -------------------------\\n@use \'variables\' as v;\\n\\n.#{v.$css-prefix}-stack {\\n  display: inline-block;\\n  height: 2em;\\n  line-height: 2em;\\n  position: relative;\\n  vertical-align: v.$stack-vertical-align;\\n  width: v.$stack-width;\\n}\\n\\n.#{v.$css-prefix}-stack-1x,\\n.#{v.$css-prefix}-stack-2x {\\n  --#{v.$css-prefix}-width: 100%;\\n\\n  inset: 0;\\n  position: absolute;\\n  text-align: center;\\n  width: var(--#{v.$css-prefix}-width);\\n  z-index: var(--#{v.$css-prefix}-stack-z-index, #{v.$stack-z-index});\\n}\\n\\n.#{v.$css-prefix}-stack-1x {\\n  line-height: inherit;\\n}\\n\\n.#{v.$css-prefix}-stack-2x {\\n  font-size: 2em;\\n}\\n\\n.#{v.$css-prefix}-inverse {\\n  color: var(--#{v.$css-prefix}-inverse, #{v.$inverse});\\n}\\n","// variables\\n// --------------------------\\n\\n$css-prefix            : fa !default;\\n$style                 : 900 !default;\\n$family                : \\"Font Awesome 7 Free\\" !default;\\n\\n$icon-property         : --fa !default;\\n\\n$display               : inline-block !default;\\n\\n$fw-width              : calc((20/16) * 1em) !default;\\n$inverse               : #fff !default;\\n\\n$border-box-sizing     : content-box !default;\\n$border-color          : #eee !default;\\n$border-padding        : 0.1875em 0.25em !default;\\n$border-radius         : .1em !default;\\n$border-style          : solid !default;\\n$border-width          : .0625em !default;\\n\\n$size-scale-2xs        : 10 !default;\\n$size-scale-xs         : 12 !default;\\n$size-scale-sm         : 14 !default;\\n$size-scale-base       : 16 !default;\\n$size-scale-lg         : 20 !default;\\n$size-scale-xl         : 24 !default;\\n$size-scale-2xl    