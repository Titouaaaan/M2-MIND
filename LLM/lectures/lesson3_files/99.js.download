ction.section-title {\\n        background:  #252955;\\n        h1 {\\n            background: inherit;\\n            color: white;\\n            box-shadow: inherit;\\n            font-size: 2.5rem;\\n            position: absolute;\\n            width: 100%;\\n            text-align: center;\\n            top: 50%;\\n            transform: translateY(-50%);\\n        }\\n    }\\n\\n    section.subsection {\\n          background:  #252955;\\n          .title {\\n            h1 {\\n              color: white;\\n              font-size: 2.5rem;\\n            }\\n            h2 {\\n              color: white;\\n              font-size: 2rem;\\n            }\\n            h1, h2 {\\n              background:  #252955;\\n              box-shadow: none;\\n              text-align: center;\\n            }\\n\\n            position: absolute;\\n            width: 100%;\\n            top: 50%;\\n            transform: translateY(-50%);\\n         }\\n    }\\n\\n    .main {\\n        background: white;\\n        height: 100%;\\n        height: 100%;\\n        width: 100%;\\n\\n        display: flex;\\n        flex-direction: column;\\n        justify-content: space-between;\\n        // display: grid;\\n        // grid-template-columns: 100%;\\n        // grid-template-rows: 50px calc(100vh-100px) 50px;\\n        // padding: 0;\\n        // justify-content: space-between;\\n\\n        & > * {\\n            flex-grow: 1;\\n        }\\n\\n        .inner {\\n            position: relative;\\n            padding: 10px;\\n            margin: 0;\\n            overflow: auto;\\n            @media print{\\n              overflow: hidden;\\n            }\\n            height: calc(100vh - 100px);\\n        }\\n        .header, .footer {\\n            box-sizing: border-box;\\n            padding: 5px;\\n            flex-grow: 0;\\n            align-items: center;\\n            display: grid;\\n        }\\n        .header {\\n            grid-template-columns: 10fr 1fr;\\n            background: white; // #252955; /* #464A68; */\\n            width: 100%;\\n            font-weight: bold;\\n            font-variant: small-caps;\\n            // height: 50px;\\n            color: #252955;\\n        }\\n        .footer {\\n            font-size: small;\\n            // height: 30px;\\n            grid-template-columns: 90% 1fr;\\n            background: white; /* #464A68; */\\n            width: 100%;\\n            color: #252955;\\n        }\\n    }\\n}\\n\\n\\n\\n\\n// Boxes etc.\\n\\n.titled-box {\\n    position: relative;\\n    border: 2px solid $darkblue;\\n    border-radius: 10px;\\n\\n    margin-top: 1rem;\\n    padding: .4rem 10px;\\n\\n    & > .title {\\n        color: $darkblue;\\n        position: absolute;\\n        background: white;\\n        padding: 0 5px;\\n        margin-left: 5px;\\n        top: -.5rem;\\n    }\\n}\\n\\n.reveal {\\n    ol, ul {\\n        margin: 0 0 0 0 !important;\\n        padding-left: 20px !important;\\n    }\\n}\\n\\n// Formatting\\ndl.spaced {\\n  & > dt {\\n    margin-top: 6pt;\\n  }\\n}\\n\\ndl.spaced2x {\\n  & > dt {\\n    margin-top: 12pt;\\n  }\\n}\\nul.spaced, ol.spaced {\\n  & > li {\\n    margin-top: 6pt;\\n  }\\n}\\n\\nul.spaced2x, ol.spaced2x {\\n  & > li {\\n    margin-top: 12pt;\\n  }\\n}\\n"],"sourceRoot":""}]);\n// Exports\n/* harmony default export */ const __WEBPACK_DEFAULT_EXPORT__ = (___CSS_LOADER_EXPORT___);\n//# sourceURL=[module]\n//# sourceMappingURL=data:application/json;charset=utf-8;base64,\n//# sourceURL=webpack-internal:///1662\n')},1891:(__unused_webpack_module,__webpack_exports__,__webpack_require__)=>{eval('__webpack_require__.r(__webpack_exports__);\n/* harmony export */ __webpack_require__.d(__webpack_exports__, {\n/* harmony export */   "default": () => (__WEBPACK_DEFAULT_EXPORT__)\n/* harmony export */ });\n/* harmony import */ var _node_modules_style_loader_dist_runtime_injectStylesIntoStyleTag_js__WEBPACK_IMPORTED_MODULE_0__ = __webpack_require__(5072);\n/* harmony impor